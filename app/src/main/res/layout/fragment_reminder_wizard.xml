<?xml version="1.0" encoding="utf-8"?>
<!--
  Three steps, one decision each:
    1. which medicine and how much
    2. when it rings (DoseWheel) and how often
    3. confirm, with the next dose counted down
  The wizard keeps the existing save path; only the shape of the screen changed.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarWizard"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/title_new_reminder"
        app:titleTextColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- progress: three dots, the current one filled -->
    <dev.anonymous.eilaji.ui.components.StepStepper
        android:id="@+id/stepperWizard"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWizard" />

    <TextView
        android:id="@+id/tvStepTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:text="@string/step_medicine"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/_20ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepperWizard" />

    <TextView
        android:id="@+id/tvStepSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:textColor="@attr/colorOnSurfaceVariant"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStepTitle"
        tools:text="Pick the medicine you take" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_90sdp"
        app:layout_constraintBottom_toTopOf="@id/wizardBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStepSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_24sdp"
            android:paddingTop="@dimen/_12sdp">

            <!-- STEP 1 -->
            <LinearLayout
                android:id="@+id/stepMedicine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMedicineName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/medicine_name">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actMedicineName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="56dp"
                        android:textSize="@dimen/_15ssp"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDosage"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:hint="@string/dosage_optional">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reminderDosageEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:minHeight="56dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/dose_count"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/_13ssp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buDoseMinus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="−"
                        android:textSize="@dimen/_20ssp" />

                    <TextView
                        android:id="@+id/tvDoseCount"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/_20ssp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buDosePlus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="+"
                        android:textSize="@dimen/_20ssp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEP 2 -->
            <LinearLayout
                android:id="@+id/stepTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <dev.anonymous.eilaji.ui.components.DoseWheel
                    android:id="@+id/doseWheel"
                    android:layout_width="match_parent"
                    android:layout_height="280dp" />

                <TextView
                    android:id="@+id/tvChosenTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/_18ssp"
                    android:textStyle="bold"
                    tools:text="08:30 AM" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMorning"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/chip_morning" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNoon"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/chip_noon" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEvening"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/chip_evening" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNight"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/chip_night" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/repeat"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/_13ssp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOnce"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:text="@string/repeat_once" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDaily"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/repeat_daily" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWeekly"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/repeat_weekly" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- STEP 3 -->
            <LinearLayout
                android:id="@+id/stepConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_18sdp">

                        <TextView
                            android:id="@+id/tvConfirmMedicine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/_17ssp"
                            android:textStyle="bold"
                            tools:text="Panadol 500mg" />

                        <TextView
                            android:id="@+id/tvConfirmDosage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/_13ssp"
                            tools:text="1 tablet" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/_12sdp"
                            android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/tvConfirmTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/_15ssp"
                            tools:text="Every day at 08:30 AM" />

                        <TextView
                            android:id="@+id/tvNextDose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textColor="@color/primary_color"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold"
                            tools:text="Next dose in 6h 20m" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchIsActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/reminder_active" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- one bottom bar: back on step 1, continue elsewhere, save on the last step -->
    <LinearLayout
        android:id="@+id/wizardBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buWizardBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/back"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buWizardNext"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="140dp"
            android:text="@string/continue_label" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>