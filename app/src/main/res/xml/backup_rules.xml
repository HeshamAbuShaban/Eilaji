<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below. Tokens stay on the device;
   the reminder/favourite databases hold health data and are excluded too.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref">
        <file path="secure_app_prefs.xml" />
        <file path="app_prefs.xml" />
    </exclude>
    <exclude domain="database">
        <file path="reminder.db" />
        <file path="favorites.db" />
    </exclude>
</full-backup-content>
