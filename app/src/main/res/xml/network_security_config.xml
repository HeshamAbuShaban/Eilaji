<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy: no cleartext HTTP anywhere.
  Development builds get cleartext for localhost/emulator from res-debug/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
